{
    "extends": "@snailicide/build-config/tsconfig-base",
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM"],
        "composite": true,
        "noEmit": true,
        "module": "ESNext",
        "rootDir": ".",
        "types": ["node"],
        "esModuleInterop": true,
        "moduleResolution": "bundler"
    },
    "exclude": ["./node_modules"],
    "include": ["./**/*.test.ts"],
    "references": [{ "path": "./src" }]
}
